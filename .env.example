# URL del proyecto de Supabase (Settings -> Data API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anon/publishable de Supabase (Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-aqui

# Opcional (recomendado para producción en Vercel): clave service_role para operaciones desde API routes del servidor
# NUNCA expongas esta clave con prefijo NEXT_PUBLIC_
# SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role-aqui
